// Dedicated Google Image sitemap — poster, backdrop, AI thumbnail, uploader thumbnail.
export const Route = createFileRoute("/sitemap-images.xml")({
  server: {
    handlers: {
      GET: async () => {
        let rows: Row[] = [];
