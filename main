const BASE_URL = "https://ibona.egreedtech.org";

export const Route = createFileRoute("/sitemap-years.xml")({
  server: {
    handlers: {
      GET: async () => {
        const now = await latestContentLastmod();
        const urls = recentYears().map((y) => {
